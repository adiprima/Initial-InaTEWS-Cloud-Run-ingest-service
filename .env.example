PORT=8080
DB_USER=inatews_ingest
DB_PASSWORD=replace-through-secret-manager
DB_NAME=inatews_public
INSTANCE_CONNECTION_NAME=gempa-integration-prod:asia-southeast2:inatews-mysql-prod
# Cloud Run uses /cloudsql/INSTANCE_CONNECTION_NAME. For local TCP tests, set
# DB_HOST=127.0.0.1 and DB_PORT=3306 and leave DB_SOCKET empty.
DB_SOCKET=/cloudsql/gempa-integration-prod:asia-southeast2:inatews-mysql-prod
DB_HOST=
DB_PORT=3306
DB_MAX_OPEN_CONNS=7
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
MAX_REQUEST_BYTES=15728640
