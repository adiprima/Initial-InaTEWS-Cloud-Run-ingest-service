FROM golang:1.25-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/inatews-admin-api ./cmd/adminapi

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/inatews-admin-api /inatews-admin-api
USER nonroot:nonroot
ENTRYPOINT ["/inatews-admin-api"]
