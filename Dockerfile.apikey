FROM golang:1.25-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/inatews-apikey ./cmd/apikey

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/inatews-apikey /inatews-apikey
USER nonroot:nonroot
ENTRYPOINT ["/inatews-apikey"]
